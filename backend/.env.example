MONGODB_URI=
PORT=3002
SERVER_HOST=localhost
CORS_ORIGIN=http://localhost:5176
FRONTEND_URL=http://localhost:5176

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Email, option 1: SMTP (works locally and on hosts that allow outgoing mail ports)
MAIL_HOST=
EMAIL_PORT=
MAIL_USER=
MAIL_PASS=

# Email, option 2: Brevo HTTPS API. When BREVO_API_KEY is set it is used instead of SMTP.
# MAIL_FROM must be a sender verified in Brevo; it defaults to MAIL_USER.
BREVO_API_KEY=
MAIL_FROM=

# File uploads. Without these, forms work but attachments are not stored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: a real admin account, created when the server starts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# How far the college is from UTC, in minutes. 330 is India.
COLLEGE_UTC_OFFSET_MINUTES=330

# Rebuild the sample college (demo accounts and data) every time the server starts
SEED_ON_START=false
